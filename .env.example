# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.8-flash

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional Integrations
CRYPTOPANIC_API_KEY=
DISCORD_WEBHOOK_URL=

# Circuit Breaker Governance (default: false)
# ENABLE_CIRCUIT_BREAKER=false
# MAX_DRAWDOWN_PERCENT=5.0

# Dynamic Support/Resistance Alerts (default: false to prevent spamming notifications)
# ENABLE_DYNAMIC_LEVEL_ALERTS=false
# DYNAMIC_LEVEL_COOLDOWN_MINUTES=120

# Telegram Signal Message Verbosity (default: false for clean, beginner-friendly signals without walls of text)
# VERBOSE_TELEGRAM_SIGNALS=false

